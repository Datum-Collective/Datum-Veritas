from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path
from collections import defaultdict
import random

import numpy as np
import pandas as pd


# ============================================================
# VERITAS SYNTHETIC PROCUREMENT WORLD
#
# Design principles:
#   1. Synthetic data is NOT presented as real government data.
#   2. Structure is aligned with Indian public procurement practice.
#   3. Markets have different supplier-pool sizes.
#   4. Participation depends on category, region, value and method.
#   5. Legitimate specialization is explicitly represented.
#   6. Anomalies are injected after the normal world exists.
#   7. scenario_truth.csv is evaluation-only and NEVER used by
#      the detection pipeline.
# ============================================================

