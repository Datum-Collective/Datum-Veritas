def generate_departments() -> pd.DataFrame:
    return pd.DataFrame(
        [
            {
                "organization_id": department_id,
                "department_id": department_id,
                "organization_name": name,
                "department_name": name,
                "organization_type": "STATE_PROCUREMENT_ENTITY",
                "region": region,
            }
            for department_id, name, region in DEPARTMENTS
        ]
    )


# ============================================================
# VENDORS / MARKET STRUCTURE
# ============================================================

def generate_vendors(
    rng: random.Random,
    count: int = 550,
) -> pd.DataFrame:

    categories = list(CATEGORIES.keys())

    rows = []

    # Give every vendor a real primary market.
    # Secondary markets are correlated with the primary market
    # rather than completely random.
    related = {
        "ROAD_CONSTRUCTION": ["CIVIL_MAINTENANCE", "WATER_INFRASTRUCTURE"],
        "BUILDING_CONSTRUCTION": ["CIVIL_MAINTENANCE", "ELECTRICAL_EQUIPMENT"],
        "ELECTRICAL_EQUIPMENT": ["IT_SERVICES", "CIVIL_MAINTENANCE"],
        "MEDICAL_SUPPLIES": ["LAB_EQUIPMENT"],
        "IT_SERVICES": ["ELECTRICAL_EQUIPMENT", "LAB_EQUIPMENT"],
        "WATER_INFRASTRUCTURE": ["ROAD_CONSTRUCTION", "CIVIL_MAINTENANCE"],
        "FURNITURE": ["BUILDING_CONSTRUCTION"],
        "VEHICLE_SUPPLIES": ["CIVIL_MAINTENANCE"],
        "CIVIL_MAINTENANCE": ["ROAD_CONSTRUCTION", "BUILDING_CONSTRUCTION"],
        "LAB_EQUIPMENT": ["MEDICAL_SUPPLIES", "IT_SERVICES"],
    }

    for i in range(count):
        primary = rng.choices(
            categories,
            weights=[
                1.25 if c in {
                    "ROAD_CONSTRUCTION",
                    "BUILDING_CONSTRUCTION",
                    "CIVIL_MAINTENANCE",
                }
                else 1.0
                for c in categories
            ],
            k=1,
        )[0]

        secondary = rng.choice(related[primary])

        region = rng.choices(
            REGIONS,
            weights=[18, 22, 12, 25, 10, 13],
            k=1,
        )[0]

        specialization = clamp(
            rng.gauss(
                CATEGORIES[primary]["specialization"],
                0.08,
            ),
            0.45,
            0.99,
        )

        registration = (
            datetime(2012, 1, 1)
            + timedelta(days=rng.randint(0, 4800))
        )

        rows.append(
            {
                "vendor_id": f"V{i + 1:04d}",
                "legal_name": vendor_name(i),
                "name": vendor_name(i),
                "vendor_type": rng.choices(
                    [
                        "COMPANY",
                        "PARTNERSHIP",
                        "PROPRIETORSHIP",
                    ],
                    weights=[0.68, 0.17, 0.15],
                    k=1,
                )[0],
                "region": region,
                "headquarters_region": region,
                "primary_category": primary,
                "secondary_category": secondary,
                "specialization": round(specialization, 3),
                "registration_date": registration.date().isoformat(),
            }
        )

    return pd.DataFrame(rows)


def force_scenario_vendor_markets(
    vendors: pd.DataFrame,
) -> pd.DataFrame:
    """
    Ensure every controlled scenario vendor is genuinely qualified for
    the market in which its scenario is planted.
    """

    assignments = {
        "CIVIL_MAINTENANCE": [
            "V0001",
            "V0024",
            "V0091",
            "V0051",
            "V0052",
            "V0053",
        ],
        "LAB_EQUIPMENT": [
            "V0010",
            "V0020",
        ],
        "ROAD_CONSTRUCTION": [
            "V0042",
            "V0043",
            "V0071",
            "V0072",
            "V0073",
            "V0074",
        ],
        "ELECTRICAL_EQUIPMENT": [
            "V0061",
            "V0062",
            "V0063",
        ],
    }

    secondary = {
        "CIVIL_MAINTENANCE": "ROAD_CONSTRUCTION",
        "LAB_EQUIPMENT": "MEDICAL_SUPPLIES",
        "ROAD_CONSTRUCTION": "CIVIL_MAINTENANCE",
        "ELECTRICAL_EQUIPMENT": "IT_SERVICES",
    }

    existing_ids = set(vendors["vendor_id"])

    for category, vendor_ids in assignments.items():

        for vendor_id in vendor_ids:

            if vendor_id not in existing_ids:
                raise ValueError(
                    f"Scenario vendor {vendor_id} does not exist."
                )

            mask = vendors["vendor_id"] == vendor_id

            vendors.loc[
                mask,
                "primary_category",
            ] = category

            vendors.loc[
                mask,
                "secondary_category",
            ] = secondary[category]

    return vendors


def build_market_pools(
    vendors: pd.DataFrame,
) -> dict[str, set[str]]:
    """
    Construct the effective qualified supplier pool for each category.

    Mandatory scenario vendors are included first. The remaining pool
    slots are filled by the strongest eligible suppliers. This guarantees
    that controlled scenarios remain inside the observable supplier
    market without enlarging the market artificially.
    """

    required_by_category = {
        "CIVIL_MAINTENANCE": [
            "V0001",
            "V0024",
            "V0091",
            "V0051",
            "V0052",
            "V0053",
        ],
        "LAB_EQUIPMENT": [
            "V0010",
            "V0020",
        ],
        "ROAD_CONSTRUCTION": [
            "V0042",
            "V0043",
            "V0071",
            "V0072",
            "V0073",
            "V0074",
        ],
        "ELECTRICAL_EQUIPMENT": [
            "V0061",
            "V0062",
            "V0063",
        ],
    }

    pools = {}

    for category, profile in CATEGORIES.items():

        candidates = vendors[
            (vendors["primary_category"] == category)
            | (vendors["secondary_category"] == category)
        ].copy()

        candidate_ids = set(
            candidates["vendor_id"]
        )

        required = required_by_category.get(
            category,
            [],
        )

        missing = [
            vendor_id
            for vendor_id in required
            if vendor_id not in candidate_ids
        ]

        if missing:
            raise ValueError(
                f"Required scenario vendors are not qualified "
                f"for {category}: {missing}"
            )

        target = min(
            profile["market_size"],
            len(candidates),
        )

        if len(required) > target:
            raise ValueError(
                f"{category} market size {target} is smaller than "
                f"its {len(required)} mandatory scenario vendors."
            )

        candidates = candidates.sort_values(
            ["specialization", "vendor_id"],
            ascending=[False, True],
        )

        # Mandatory scenario participants are locked into the pool.
        selected = list(required)
        selected_set = set(selected)

        # Fill remaining slots with the strongest eligible suppliers.
        for vendor_id in candidates["vendor_id"]:

            if len(selected) >= target:
                break

            if vendor_id in selected_set:
                continue

            selected.append(vendor_id)
            selected_set.add(vendor_id)

        pools[category] = set(selected)

    return pools
def build_market_profiles(
    vendors: pd.DataFrame,
    market_pools: dict[str, set[str]],
) -> pd.DataFrame:
    """
    Build the observable market structure from the actual effective
    supplier pools used by bid generation.
    """

    rows = []

    for category, profile in CATEGORIES.items():

        pool_ids = market_pools.get(
            category,
            set(),
        )

        candidates = vendors[
            vendors["vendor_id"].isin(pool_ids)
        ]

        rows.append(
            {
                "category": category,
                "qualified_supplier_count": int(
                    candidates["vendor_id"].nunique()
                ),
                "average_specialization": round(
                    candidates["specialization"].mean(),
                    3,
                ) if not candidates.empty else 0.0,
                "market_size_target": profile["market_size"],
            }
        )

    return pd.DataFrame(rows)


# ============================================================
# TENDERS
# ============================================================

def generate_tenders(
    rng: random.Random,
    departments: pd.DataFrame,
    count: int = 2500,
) -> pd.DataFrame:

    rows = []

    category_weights = {
        "ROAD_CONSTRUCTION": 1.20,
        "BUILDING_CONSTRUCTION": 1.05,
        "ELECTRICAL_EQUIPMENT": 0.90,
        "MEDICAL_SUPPLIES": 1.00,
        "IT_SERVICES": 0.95,
        "WATER_INFRASTRUCTURE": 0.85,
        "FURNITURE": 0.75,
        "VEHICLE_SUPPLIES": 0.65,
        "CIVIL_MAINTENANCE": 1.15,
        "LAB_EQUIPMENT": 0.40,
    }

    categories = list(CATEGORIES.keys())

    for i in range(count):
        department = departments.iloc[
            rng.randrange(len(departments))
        ]

        category = rng.choices(
            categories,
            weights=[category_weights[c] for c in categories],
            k=1,
        )[0]

        profile = CATEGORIES[category]

        subcategory = rng.choice(
            profile["subcategories"]
        )

        # Real procurement values are heavily right-skewed.
        estimated_value = np.random.default_rng(
            rng.randint(0, 2_000_000_000)
        ).lognormal(
            mean=np.log(profile["value_median"]),
            sigma=profile["value_sigma"],
        )

        estimated_value = float(
            np.clip(
                estimated_value,
                250_000,
                500_000_000,
            )
        )

        publication = random_date(rng)

        method = procurement_method(
            rng,
            category,
            estimated_value,
        )

        # Tender periods vary by procedure.
        if method == "OPEN":
            duration = rng.randint(12, 45)
        elif method == "LIMITED":
            duration = rng.randint(7, 30)
        else:
            duration = rng.randint(25, 75)

        closing = publication + timedelta(days=duration)

        if closing > END_DATE:
            closing = END_DATE

        award_criteria = (
            "QUALITY_AND_COST"
            if category in {
                "IT_SERVICES",
                "LAB_EQUIPMENT",
            }
            and rng.random() < 0.35
            else "LOWEST_PRICE"
        )

        rows.append(
            {
                "tender_id": f"T{i + 1:05d}",
                "ocid": f"ocds-synthetic-{i + 1:05d}",
                "organization_id": department["organization_id"],
                "department_id": department["department_id"],
                "department_name": department["department_name"],
                "category": category,
                "subcategory": subcategory,
                "item_code": f"ITEM-{category[:4]}-{rng.randint(100, 999)}",
                "region": department["region"],
                "procurement_method": method,
                "award_criteria": award_criteria,
                "eligibility_type": (
                    "OPEN_ELIGIBILITY"
                    if method == "OPEN"
                    else "QUALIFIED_SUPPLIERS"
                ),
                "publication_date": publication.date().isoformat(),
                "closing_date": closing.date().isoformat(),
                "estimated_value": round(
                    estimated_value,
                    2,
                ),
                "status": "AWARDED",
            }
        )

    return pd.DataFrame(rows)


# ============================================================
# SUPPLIER QUALIFICATION
# ============================================================

def qualified_vendors(
    tender: pd.Series,
    vendors: pd.DataFrame,
    market_pools: dict[str, set[str]],
) -> pd.DataFrame:
    """
    Return vendors belonging to the effective supplier pool for the
    tender's category.

    Regional preference and specialization influence participation
    probability, but vendors outside the effective market pool cannot
    participate.
    """

    category = tender["category"]
    region = tender["region"]

    pool_ids = market_pools.get(
        category,
        set(),
    )

    market = vendors[
        vendors["vendor_id"].isin(pool_ids)
    ].copy()

    # Local suppliers are more likely to participate, but non-local
    # suppliers remain possible.
    market["regional_score"] = np.where(
        market["region"] == region,
        1.8,
        0.55,
    )

    market["qualification_score"] = (
        market["regional_score"]
        * (0.65 + market["specialization"])
    )

    return market


# ============================================================
# BIDS
# ============================================================

def bidder_count(
    rng: random.Random,
    tender: pd.Series,
    supplier_pool_size: int,
) -> int:

    method = tender["procurement_method"]

    if method == "LIMITED":
        low, high = 2, 5
    elif method == "TWO_STAGE":
        low, high = 2, 6
    else:
        low, high = 2, 9

    # Small supplier markets naturally produce fewer bidders.
    if supplier_pool_size <= 5:
        low, high = 2, min(high, supplier_pool_size)
    elif supplier_pool_size <= 15:
        high = min(high, 6)

    # Occasionally produce larger competitive fields.
    if rng.random() < 0.08 and supplier_pool_size >= 10:
        high = min(supplier_pool_size, high + rng.randint(2, 5))

    return rng.randint(
        min(low, supplier_pool_size),
        min(high, supplier_pool_size),
    )


def generate_bids(
    rng: random.Random,
    tenders: pd.DataFrame,
    vendors: pd.DataFrame,
    market_pools: dict[str, set[str]],
) -> pd.DataFrame:

    rows = []
    bid_id = 1

    for _, tender in tenders.iterrows():

        candidates = qualified_vendors(
            tender,
            vendors,
            market_pools,
        )

        if candidates.empty:
            candidates = vendors.copy()

        count = bidder_count(
            rng,
            tender,
            len(candidates),
        )

        # Weighted sampling without replacement.
        # This prevents a vendor from being selected twice for the same
        # tender before duplicate cleanup.
        available = candidates.copy()
        selected_rows = []

        target_count = min(
            count,
            len(available),
        )

        for _ in range(target_count):

            weights = available[
                "qualification_score"
            ].to_numpy(dtype=float)

            weights = weights / weights.sum()

            chosen_position = rng.choices(
                list(range(len(available))),
                weights=weights,
                k=1,
            )[0]

            selected_rows.append(
                available.iloc[chosen_position]
            )

            available = available.drop(
                available.index[chosen_position]
            )

        selected = pd.DataFrame(
            selected_rows
        ).reset_index(drop=True)

        estimates = []

        for _, vendor in selected.iterrows():

            specialization = float(
                vendor["specialization"]
            )

            # More specialized firms have somewhat lower price
            # uncertainty, but markets still contain meaningful noise.
            volatility = clamp(
                0.075 - specialization * 0.045,
                0.018,
                0.065,
            )

            # Vendor-specific competitive tendency.
            competitive_bias = rng.gauss(
                0.0,
                0.018,
            )

            ratio = rng.gauss(
                1.00 + competitive_bias,
                volatility,
            )

            ratio = clamp(
                ratio,
                0.72,
                1.28,
            )

            amount = (
                float(tender["estimated_value"])
                * ratio
            )

            publication = datetime.fromisoformat(
                tender["publication_date"]
            )

            closing = datetime.fromisoformat(
                tender["closing_date"]
            )

            tender_seconds = max(
                3600,
                int(
                    (
                        closing - publication
                    ).total_seconds()
                ),
            )

            # Submissions are not uniformly distributed:
            # most occur during the active tender period, with
            # a smaller deadline-clustering effect.
            if rng.random() < 0.18:
                seconds = int(
                    tender_seconds
                    * rng.uniform(0.90, 0.999)
                )
            else:
                seconds = int(
                    tender_seconds
                    * rng.betavariate(2.2, 2.0)
                )

            submitted = publication + timedelta(
                seconds=max(60, seconds)
            )

            estimates.append(
                {
                    "vendor": vendor,
                    "amount": amount,
                    "submitted": submitted,
                }
            )

        estimates.sort(
            key=lambda x: x["amount"]
        )

        for rank, estimate in enumerate(
            estimates,
            start=1,
        ):
            vendor = estimate["vendor"]

            rows.append(
                {
                    "bid_id": f"B{bid_id:06d}",
                    "tender_id": tender["tender_id"],
                    "vendor_id": vendor["vendor_id"],
                    "bid_amount": round(
                        estimate["amount"],
                        2,
                    ),
                    "submitted_at": estimate[
                        "submitted"
                    ].isoformat(),
                    "rank": rank,
                    "status": (
                        "RESPONSIVE"
                        if rng.random() < 0.96
                        else "NON_RESPONSIVE"
                    ),
                }
            )

            bid_id += 1

    return pd.DataFrame(rows)


# ============================================================
# AWARDS / CONTRACTS
# ============================================================

def generate_awards_and_contracts(
    rng: random.Random,
    tenders: pd.DataFrame,
    bids: pd.DataFrame,
):
    awards = []
    contracts = []

    for tender_id, group in bids.groupby("tender_id"):
        tender = tenders[
            tenders["tender_id"] == tender_id
        ].iloc[0]

        responsive = group[
            group["status"] == "RESPONSIVE"
        ]

        if responsive.empty:
            responsive = group

        winner = responsive.sort_values(
            "bid_amount"
        ).iloc[0]

        award_date = (
            datetime.fromisoformat(
                tender["closing_date"]
            )
            + timedelta(
                days=rng.randint(2, 30)
            )
        )

        # Contract value generally tracks award value.
        award_value = float(
            winner["bid_amount"]
            * rng.uniform(0.985, 1.01)
        )

        award_id = f"A-{tender_id}"

        awards.append(
            {
                "award_id": award_id,
                "tender_id": tender_id,
                "vendor_id": winner["vendor_id"],
                "award_date": award_date.date().isoformat(),
                "award_value": round(
                    award_value,
                    2,
                ),
            }
        )

        duration_days = rng.randint(
            60,
            540,
        )

        start_date = award_date + timedelta(
            days=rng.randint(7, 30)
        )

        end_date = (
            start_date
            + timedelta(days=duration_days)
        )

        contracts.append(
            {
                "contract_id": f"C-{tender_id}",
                "tender_id": tender_id,
                "award_id": award_id,
                "vendor_id": winner["vendor_id"],
                "contract_value": round(
                    award_value,
                    2,
                ),
                "start_date": start_date.date().isoformat(),
                "end_date": end_date.date().isoformat(),
                "status": "ACTIVE",
            }
        )

    return (
        pd.DataFrame(awards),
        pd.DataFrame(contracts),
    )


# ============================================================
# PEOPLE / ADDRESSES / RELATIONSHIPS
# ============================================================

def generate_people_and_addresses(
    rng: random.Random,
    vendors: pd.DataFrame,
):
    people = []
    addresses = []
    relationships = []

    for i in range(1, 180):
        people.append(
            {
                "person_id": f"P{i:04d}",
                "name": f"Person-{i:04d}",
                "role": rng.choice(
                    [
                        "DIRECTOR",
                        "PARTNER",
                        "OWNER",
                    ]
                ),
            }
        )

    for i in range(1, 140):
        addresses.append(
            {
                "address_id": f"ADDR-{i:04d}",
                "district": rng.choice(
                    [
                        "Bengaluru Urban",
                        "Mysuru",
                        "Belagavi",
                        "Mangaluru",
                        "Hubballi",
                        "Tumakuru",
                        "Shivamogga",
                        "Chennai",
                        "Coimbatore",
                        "Tirupati",
                    ]
                ),
                "state": rng.choice(
                    [
                        "KARNATAKA",
                        "TAMIL_NADU",
                        "ANDHRA_PRADESH",
                    ]
                ),
                "postal_code": str(
                    rng.randint(
                        500000,
                        599999,
                    )
                ),
            }
        )

    # Normal world contains some legitimate shared structures.
    vendor_ids = vendors["vendor_id"].tolist()

    relationship_id = 1

    for _ in range(35):
        a, b = rng.sample(
            vendor_ids,
            2,
        )

        relationships.append(
            {
                "relationship_id": f"R{relationship_id:04d}",
                "entity_a": a,
                "entity_b": f"P{rng.randint(1, 179):04d}",
                "relationship_type": "SHARED_DIRECTOR",
                "valid_from": "2020-01-01",
                "valid_to": None,
            }
        )

        relationship_id += 1

    for _ in range(25):
        a, b = rng.sample(
            vendor_ids,
            2,
        )

        relationships.append(
            {
                "relationship_id": f"R{relationship_id:04d}",
                "entity_a": a,
                "entity_b": f"ADDR-{rng.randint(1, 139):04d}",
                "relationship_type": "SHARED_ADDRESS",
                "valid_from": "2020-01-01",
                "valid_to": None,
            }
        )

        relationship_id += 1

    return (
        pd.DataFrame(people),
        pd.DataFrame(addresses),
        pd.DataFrame(relationships),
    )


# ============================================================
# SCENARIO INJECTION
#
# These happen AFTER the normal procurement world exists.
# Detectors never see scenario_truth.csv.
# ============================================================

def add_truth(
    truth_rows: list[dict],
    scenario: str,
    entity_ids: list[str],
    description: str,
):
    truth_rows.append(
        {
            "scenario": scenario,
            "entities": "|".join(entity_ids),
            "description": description,
        }
    )


def configure_scenario_vendor_markets(
    vendors: pd.DataFrame,
):
    """
    Ensure every controlled-scenario vendor is genuinely
    qualified for the market used by its scenario.

    scenario_truth.csv remains evaluation-only; these are normal
    vendor market attributes visible to the detector.
    """

    scenario_markets = {
        "V0001": "CIVIL_MAINTENANCE",
        "V0024": "CIVIL_MAINTENANCE",
        "V0091": "CIVIL_MAINTENANCE",

        "V0010": "LAB_EQUIPMENT",
        "V0020": "LAB_EQUIPMENT",

        "V0042": "ROAD_CONSTRUCTION",
        "V0043": "ROAD_CONSTRUCTION",

        "V0051": "CIVIL_MAINTENANCE",
        "V0052": "CIVIL_MAINTENANCE",
        "V0053": "CIVIL_MAINTENANCE",

        "V0061": "ELECTRICAL_EQUIPMENT",
        "V0062": "ELECTRICAL_EQUIPMENT",
        "V0063": "ELECTRICAL_EQUIPMENT",

        "V0071": "ROAD_CONSTRUCTION",
        "V0072": "ROAD_CONSTRUCTION",
        "V0073": "ROAD_CONSTRUCTION",
        "V0074": "ROAD_CONSTRUCTION",
    }

    for vendor_id, category in scenario_markets.items():
        mask = vendors["vendor_id"] == vendor_id

        if not mask.any():
            raise ValueError(
                f"Scenario vendor {vendor_id} does not exist."
            )

        vendors.loc[mask, "primary_category"] = category

    return vendors


def plant_repeated_bidder_network(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    target_vendors = [
        "V0001",
        "V0024",
        "V0091",
    ]

    pool = set(
        market_pools["CIVIL_MAINTENANCE"]
    )

    missing = set(target_vendors) - pool

    if missing:
        raise ValueError(
            "Repeated bidder scenario vendors missing from "
            f"CIVIL_MAINTENANCE pool: {sorted(missing)}"
        )

    eligible = tenders[
        tenders["category"] == "CIVIL_MAINTENANCE"
    ]

    selected = eligible.sample(
        n=min(35, len(eligible)),
        random_state=SEED,
    )

    for _, tender in selected.iterrows():
        tender_id = tender["tender_id"]

        existing = bids[
            bids["tender_id"] == tender_id
        ]

        # Ensure all three participate.
        for vendor_id in target_vendors:
            if not (
                existing["vendor_id"]
                == vendor_id
            ).any():

                minimum = existing[
                    "bid_amount"
                ].min()

                if pd.isna(minimum):
                    minimum = tender[
                        "estimated_value"
                    ]

                amount = minimum * rng.uniform(
                    1.002,
                    1.009,
                )

                bids.loc[len(bids)] = {
                    "bid_id": f"B-PLANTED-{len(bids):06d}",
                    "tender_id": tender_id,
                    "vendor_id": vendor_id,
                    "bid_amount": round(amount, 2),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T12:00:00",
                    "rank": 99,
                    "status": "RESPONSIVE",
                }

        # Make the three bids extremely close.
        network = bids[
            (bids["tender_id"] == tender_id)
            & bids["vendor_id"].isin(
                target_vendors
            )
        ].copy()

        base = network["bid_amount"].min()

        for index in network.index:
            bids.loc[
                index,
                "bid_amount"
            ] = round(
                base
                * rng.uniform(
                    1.000,
                    1.008,
                ),
                2,
            )

    add_truth(
        truth_rows,
        "REPEATED_BIDDER_NETWORK",
        target_vendors,
        "Three vendors repeatedly participate together across unrelated tenders.",
    )


def plant_legitimate_specialized_market(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    # This is deliberately legitimate.
    # The market itself is tiny, so repeated participation should
    # NOT automatically be treated as suspicious.
    target_vendors = [
        "V0010",
        "V0020",
    ]

    pool = set(
        market_pools["LAB_EQUIPMENT"]
    )

    missing = set(target_vendors) - pool

    if missing:
        raise ValueError(
            "Specialized-market vendors missing from "
            f"LAB_EQUIPMENT pool: {sorted(missing)}"
        )

    eligible = tenders[
        tenders["category"] == "LAB_EQUIPMENT"
    ]

    selected = eligible.sample(
        n=min(40, len(eligible)),
        random_state=SEED + 10,
    )

    for _, tender in selected.iterrows():
        tender_id = tender["tender_id"]

        existing = bids[
            bids["tender_id"] == tender_id
        ]

        for vendor_id in target_vendors:
            if not (
                existing["vendor_id"]
                == vendor_id
            ).any():

                amount = (
                    float(tender["estimated_value"])
                    * rng.uniform(
                        0.94,
                        1.05,
                    )
                )

                bids.loc[len(bids)] = {
                    "bid_id": f"B-LEGIT-{len(bids):06d}",
                    "tender_id": tender_id,
                    "vendor_id": vendor_id,
                    "bid_amount": round(
                        amount,
                        2,
                    ),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T10:00:00",
                    "rank": 1,
                    "status": "RESPONSIVE",
                }

    add_truth(
        truth_rows,
        "LEGITIMATE_SPECIALIZED_MARKET",
        target_vendors,
        "Small specialized laboratory-equipment supplier pool creates legitimate repeated participation and winner concentration.",
    )


def plant_cover_bidding(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    dominant = "V0042"
    cover = "V0043"

    pool = set(
        market_pools["ROAD_CONSTRUCTION"]
    )

    missing = {dominant, cover} - pool

    if missing:
        raise ValueError(
            "Cover-bidding vendors missing from "
            f"ROAD_CONSTRUCTION pool: {sorted(missing)}"
        )

    eligible = tenders[
        tenders["category"] == "ROAD_CONSTRUCTION"
    ]

    selected = eligible.sample(
        n=min(24, len(eligible)),
        random_state=SEED + 20,
    )

    for _, tender in selected.iterrows():
        group = bids[
            bids["tender_id"]
            == tender["tender_id"]
        ]

        if group.empty:
            continue

        minimum = group[
            "bid_amount"
        ].min()

        dominant_amount = (
            minimum * rng.uniform(
                0.995,
                1.005,
            )
        )

        cover_amount = (
            dominant_amount
            * rng.uniform(
                1.035,
                1.075,
            )
        )

        for vendor_id, amount in [
            (dominant, dominant_amount),
            (cover, cover_amount),
        ]:
            existing = bids[
                (bids["tender_id"]
                 == tender["tender_id"])
                & (bids["vendor_id"]
                   == vendor_id)
            ]

            if existing.empty:
                bids.loc[len(bids)] = {
                    "bid_id": f"B-COVER-{len(bids):06d}",
                    "tender_id": tender["tender_id"],
                    "vendor_id": vendor_id,
                    "bid_amount": round(
                        amount,
                        2,
                    ),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T11:00:00",
                    "rank": 99,
                    "status": "RESPONSIVE",
                }

    add_truth(
        truth_rows,
        "COVER_BIDDING",
        [dominant, cover],
        "One vendor repeatedly wins while another repeatedly participates at systematically higher prices.",
    )


def plant_bid_rotation(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    vendors = [
        "V0051",
        "V0052",
        "V0053",
    ]

    pool = set(
        market_pools["CIVIL_MAINTENANCE"]
    )

    missing = set(vendors) - pool

    if missing:
        raise ValueError(
            "Rotation vendors missing from "
            f"CIVIL_MAINTENANCE pool: {sorted(missing)}"
        )

    eligible = tenders[
        tenders["category"] == "CIVIL_MAINTENANCE"
    ].sort_values(
        "publication_date"
    )

    selected = eligible.head(
        min(27, len(eligible))
    )

    for i, (_, tender) in enumerate(
        selected.iterrows()
    ):
        winner = vendors[i % len(vendors)]

        group = bids[
            bids["tender_id"]
            == tender["tender_id"]
        ]

        if group.empty:
            continue

        minimum = group[
            "bid_amount"
        ].min()

        for j, vendor_id in enumerate(
            vendors
        ):
            existing = bids[
                (bids["tender_id"]
                 == tender["tender_id"])
                & (bids["vendor_id"]
                   == vendor_id)
            ]

            amount = (
                minimum
                * (
                    1.002
                    if vendor_id == winner
                    else 1.025 + j * 0.008
                )
            )

            if existing.empty:
                bids.loc[len(bids)] = {
                    "bid_id": f"B-ROT-{len(bids):06d}",
                    "tender_id": tender["tender_id"],
                    "vendor_id": vendor_id,
                    "bid_amount": round(
                        amount,
                        2,
                    ),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T09:00:00",
                    "rank": 99,
                    "status": "RESPONSIVE",
                }

    add_truth(
        truth_rows,
        "BID_ROTATION",
        vendors,
        "Winning position rotates systematically among a recurring bidder group.",
    )


def plant_geographic_allocation(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    allocation = {
        "V0061": "KA-NORTH",
        "V0062": "KA-SOUTH",
        "V0063": "KA-CENTRAL",
    }

    pool = set(
        market_pools["ELECTRICAL_EQUIPMENT"]
    )

    missing = set(allocation.keys()) - pool

    if missing:
        raise ValueError(
            "Geographic-allocation vendors missing from "
            f"ELECTRICAL_EQUIPMENT pool: {sorted(missing)}"
        )

    for vendor_id, region in allocation.items():

        eligible = tenders[
            tenders["region"]
            == region
        ].head(20)

        for _, tender in eligible.iterrows():

            group = bids[
                bids["tender_id"]
                == tender["tender_id"]
            ]

            if group.empty:
                continue

            minimum = group[
                "bid_amount"
            ].min()

            existing = bids[
                (bids["tender_id"]
                 == tender["tender_id"])
                & (bids["vendor_id"]
                   == vendor_id)
            ]

            if existing.empty:
                bids.loc[len(bids)] = {
                    "bid_id": f"B-GEO-{len(bids):06d}",
                    "tender_id": tender["tender_id"],
                    "vendor_id": vendor_id,
                    "bid_amount": round(
                        minimum * rng.uniform(
                            0.995,
                            1.01,
                        ),
                        2,
                    ),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T13:00:00",
                    "rank": 1,
                    "status": "RESPONSIVE",
                }

    add_truth(
        truth_rows,
        "GEOGRAPHIC_MARKET_ALLOCATION",
        list(allocation.keys()),
        "Different vendors dominate geographically separated procurement markets.",
    )


def plant_price_coordination(
    rng: random.Random,
    bids: pd.DataFrame,
    tenders: pd.DataFrame,
    market_pools: dict[str, list[str]],
    truth_rows: list[dict],
):
    vendors = [
        "V0071",
        "V0072",
        "V0073",
        "V0074",
    ]

    pool = set(
        market_pools["ROAD_CONSTRUCTION"]
    )

    missing = set(vendors) - pool

    if missing:
        raise ValueError(
            "Price-coordination vendors missing from "
            f"ROAD_CONSTRUCTION pool: {sorted(missing)}"
        )

    eligible = tenders[
        tenders["category"] == "ROAD_CONSTRUCTION"
    ].head(18)

    for _, tender in eligible.iterrows():

        group = bids[
            bids["tender_id"]
            == tender["tender_id"]
        ]

        if group.empty:
            continue

        base = (
            float(tender["estimated_value"])
            * rng.uniform(
                0.985,
                1.015,
            )
        )

        for i, vendor_id in enumerate(
            vendors
        ):
            existing = bids[
                (bids["tender_id"]
                 == tender["tender_id"])
                & (bids["vendor_id"]
                   == vendor_id)
            ]

            if existing.empty:
                amount = base * (
                    1
                    + i * rng.uniform(
                        0.0008,
                        0.0025,
                    )
                )

                bids.loc[len(bids)] = {
                    "bid_id": f"B-PRICE-{len(bids):06d}",
                    "tender_id": tender["tender_id"],
                    "vendor_id": vendor_id,
                    "bid_amount": round(
                        amount,
                        2,
                    ),
                    "submitted_at": tender[
                        "publication_date"
                    ] + "T14:00:00",
                    "rank": 99,
                    "status": "RESPONSIVE",
                }

    add_truth(
        truth_rows,
        "TIGHT_PRICE_CLUSTER",
        vendors,
        "Multiple bids remain unusually close after normalization by tender estimate.",
    )


def recalculate_bid_ranks(
    bids: pd.DataFrame,
):
    """Recalculate ranks after all scenario bids are injected."""

    if bids.empty:
        return bids

    bids["rank"] = (
        bids.groupby("tender_id")["bid_amount"]
        .rank(
            method="min",
            ascending=True,
        )
        .astype(int)
    )

    return bids


# ============================================================
# MAIN
# ============================================================

def main():
    rng = random.Random(SEED)

    OUTPUT_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    print()
    print("=" * 72)
    print("VERITAS SYNTHETIC PROCUREMENT WORLD")
    print("=" * 72)
    print(f"Seed: {SEED}")
    print()

    # --------------------------------------------------------
    # Normal procurement world
    # --------------------------------------------------------

    departments = generate_departments()

    vendors = generate_vendors(
        rng,
        count=550,
    )

    vendors = configure_scenario_vendor_markets(
        vendors,
    )

    vendors = force_scenario_vendor_markets(
        vendors,
    )

    market_pools = build_market_pools(
        vendors,
    )

    market_profiles = build_market_profiles(
        vendors,
        market_pools,
    )

    tenders = generate_tenders(
        rng,
        departments,
        count=2500,
    )

    bids = generate_bids(
        rng,
        tenders,
        vendors,
        market_pools,
    )

    awards, contracts = (
        generate_awards_and_contracts(
            rng,
            tenders,
            bids,
        )
    )

    people, addresses, relationships = (
        generate_people_and_addresses(
            rng,
            vendors,
        )
    )

    # --------------------------------------------------------
    # Controlled scenarios
    # --------------------------------------------------------

    truth_rows = []

    plant_repeated_bidder_network(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    plant_legitimate_specialized_market(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    plant_cover_bidding(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    plant_bid_rotation(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    plant_geographic_allocation(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    plant_price_coordination(
        rng,
        bids,
        tenders,
        market_pools,
        truth_rows,
    )

    # Scenario injection changes the bid set, so ranks must be
    # recalculated before awards/contracts are regenerated.
    bids = recalculate_bid_ranks(
        bids,
    )

    # --------------------------------------------------------
    # Recalculate awards/contracts after scenario injection.
    # --------------------------------------------------------

    awards, contracts = (
        generate_awards_and_contracts(
            rng,
            tenders,
            bids,
        )
    )

    # Keep tender-level metadata synchronized with the final
    # post-scenario bid set.
    winner_map = (
        awards
        .set_index("tender_id")["vendor_id"]
    )

    tenders["winner_id"] = (
        tenders["tender_id"]
        .map(winner_map)
    )

    tender_counts = (
        bids.groupby("tender_id")["vendor_id"]
        .nunique()
    )

    tenders["number_of_tenderers"] = (
        tenders["tender_id"]
        .map(tender_counts)
        .fillna(0)
        .astype(int)
    )

    # --------------------------------------------------------
    # Save
    # --------------------------------------------------------

    outputs = {
        "organizations.csv": departments,
        "departments.csv": departments[
            [
                "department_id",
                "department_name",
                "region",
            ]
        ],
        "vendors.csv": vendors,
        "market_profiles.csv": market_profiles,
        "persons.csv": people,
        "addresses.csv": addresses,
        "relationships.csv": relationships,
        "tenders.csv": tenders,
        "bids.csv": bids,
        "awards.csv": awards,
        "contracts.csv": contracts,
        "scenario_truth.csv": pd.DataFrame(
            truth_rows
        ),
    }

    for filename, dataframe in outputs.items():
        dataframe.to_csv(
            OUTPUT_DIR / filename,
            index=False,
        )

    # --------------------------------------------------------
    # Validation
    # --------------------------------------------------------

    print("GENERATED DATA")
    print("-" * 72)

    for filename, dataframe in outputs.items():
        print(
            f"{filename:<28}"
            f"{len(dataframe):>8,} rows"
        )

    print()
    print("MARKET STRUCTURE")
    print("-" * 72)

    print(
        market_profiles.to_string(
            index=False
        )
    )

    print()
    print("PROCUREMENT METHODS")
    print("-" * 72)

    print(
        tenders[
            "procurement_method"
        ].value_counts(
            normalize=True
        ).round(3)
    )

    print()
    print("BIDS PER TENDER")
    print("-" * 72)

    bid_counts = (
        bids.groupby("tender_id")
        .size()
    )

    print(
        bid_counts.describe().round(2)
    )

    print()
    print("PROCUREMENT VALUE DISTRIBUTION")
    print("-" * 72)

    print(
        tenders[
            "estimated_value"
        ].describe(
            percentiles=[
                0.1,
                0.25,
                0.5,
                0.75,
                0.9,
                0.95,
                0.99,
            ]
        ).round(2)
    )

    print()
    print("SCENARIOS")
    print("-" * 72)

    for row in truth_rows:
        print(
            f"{row['scenario']:<32}"
            f"{row['entities']}"
        )

    print()
    print("=" * 72)
    print("GENERATION COMPLETE")
    print(f"Output: {OUTPUT_DIR}/")
    print("=" * 72)
    print()


if __name__ == "__main__":
    main()
