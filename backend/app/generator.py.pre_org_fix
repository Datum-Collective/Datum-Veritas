# ============================================================
# UTILITIES
# ============================================================

def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def random_date(rng: random.Random) -> datetime:
    days = (END_DATE - START_DATE).days
    return START_DATE + timedelta(days=rng.randint(0, days))


def vendor_name(i: int) -> str:
    prefixes = [
        "Apex",
        "Bharat",
        "Crest",
        "Delta",
        "Eastern",
        "Frontier",
        "Galaxy",
        "Horizon",
        "Indus",
        "Jupiter",
        "Kaveri",
        "Lotus",
        "Metro",
        "National",
        "Omega",
        "Prime",
        "Quantum",
        "Raven",
        "Summit",
        "Vertex",
    ]

    suffixes = [
        "Infrastructure",
        "Engineering",
        "Enterprises",
        "Solutions",
        "Industries",
        "Systems",
        "Projects",
        "Services",
    ]

    return (
        f"{prefixes[i % len(prefixes)]} "
        f"{suffixes[(i // len(prefixes)) % len(suffixes)]} "
        f"{i + 1:03d}"
    )


def procurement_method(
    rng: random.Random,
    category: str,
    estimated_value: float,
) -> str:
    # Two-stage is more plausible for technically complex /
    # higher-value procurement than for ordinary low-value goods.
    weights = dict(METHOD_WEIGHTS)

    if category in {
        "IT_SERVICES",
        "ELECTRICAL_EQUIPMENT",
        "WATER_INFRASTRUCTURE",
        "LAB_EQUIPMENT",
    }:
        weights["TWO_STAGE"] += 0.05
        weights["OPEN"] -= 0.04
        weights["LIMITED"] -= 0.01

    if estimated_value < 2_000_000:
        weights["LIMITED"] += 0.04
        weights["OPEN"] -= 0.04

    return rng.choices(
        list(weights.keys()),
        weights=list(weights.values()),
        k=1,
    )[0]


