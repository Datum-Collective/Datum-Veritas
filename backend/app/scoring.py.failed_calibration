from __future__ import annotations

import math
from pathlib import Path

import numpy as np
import pandas as pd


BASE = Path(__file__).resolve().parents[2]
DATA = BASE / "data" / "generated"


# Independent evidence families.
FAMILY_WEIGHTS = {
    "cooccurrence": 1.00,
    "price": 0.90,
    "temporal": 0.85,
    "winner_rotation": 0.80,
    "geographic": 0.55,
    "winner_concentration": 0.40,
}

# A single detector finding should not dominate an investigation queue.
SINGLE_FAMILY_CAP = 0.58

# Contextual specialization is intentionally strong:
# unusual behavior in a genuinely narrow market is less informative.
SPECIALIZATION_FLOOR = 0.55


def load_csv(name: str) -> pd.DataFrame:
    path = DATA / name
    if not path.exists():
        raise FileNotFoundError(f"Missing detector output: {path}")
    return pd.read_csv(path)


def minmax(series: pd.Series) -> pd.Series:
    series = pd.to_numeric(series, errors="coerce").fillna(0.0)

    lo = float(series.min())
    hi = float(series.max())

    if hi <= lo:
        return pd.Series(0.0, index=series.index)

    return ((series - lo) / (hi - lo)).clip(0, 1)


def percentile_strength(
    series: pd.Series,
    low: float = 0.80,
    high: float = 0.995,
) -> pd.Series:
    """
    Convert a detector magnitude into a bounded evidence strength.

    Values below `low` percentile are deliberately weak.
    This prevents common-but-noisy detector observations from
    becoming high-priority investigations.
    """
    x = pd.to_numeric(series, errors="coerce").fillna(0.0)

    q_low = float(x.quantile(low))
    q_high = float(x.quantile(high))

    if q_high <= q_low:
        return pd.Series(0.0, index=x.index)

    return ((x - q_low) / (q_high - q_low)).clip(0, 1)


def add_record(
    records: list[dict],
    vendor_id: str,
    family: str,
    strength: float,
    explanation: str,
    context_adjustment: float = 1.0,
) -> None:
    strength = float(np.clip(strength, 0, 1))
    context_adjustment = float(np.clip(context_adjustment, 0, 1))

    if strength <= 0:
        return

    records.append(
        {
            "vendor_id": vendor_id,
            "evidence_family": family,
            "evidence_strength": strength,
            "family_weight": FAMILY_WEIGHTS[family],
            "context_adjustment": context_adjustment,
            "adjusted_strength": strength * context_adjustment,
            "explanation": explanation,
        }
    )



def robust_unit(
    series: pd.Series,
    low: float,
    high: float,
) -> pd.Series:
    """
    Map a detector's native signal into [0, 1] using explicit
    domain thresholds rather than global dataset percentiles.
    """
    x = pd.to_numeric(series, errors="coerce").fillna(0.0)

    if high <= low:
        return pd.Series(0.0, index=x.index)

    return ((x - low) / (high - low)).clip(0, 1)


def build_evidence() -> pd.DataFrame:
    records: list[dict] = []

    # ================================================================
    # CO-OCCURRENCE
    # ================================================================
    #
    # contextual_enrichment is already normalized against the
    # expected number of shared tenders.
    #
    # 1x = ordinary
    # 2x = interesting
    # 4x = strong
    # 8x+ = extreme
    #
    co = load_csv("contextual_cooccurrence.csv")

    enrichment = pd.to_numeric(
        co["contextual_enrichment"],
        errors="coerce",
    ).fillna(0)

    co_strength = robust_unit(
        enrichment,
        2.0,
        8.0,
    )

    for i, row in co.iterrows():
        strength = float(co_strength.iloc[i])

        if strength < 0.05:
            continue

        adjustment = float(
            np.clip(
                row.get("contextual_adjustment", 1.0),
                0,
                1,
            )
        )

        for vendor in (
            row["vendor_a"],
            row["vendor_b"],
        ):
            add_record(
                records,
                str(vendor),
                "cooccurrence",
                strength,
                (
                    f"{int(row['observed_shared_tenders'])} shared "
                    f"tenders; {float(row['contextual_enrichment']):.2f}x "
                    f"expected contextual co-occurrence"
                ),
                adjustment,
            )

    # ================================================================
    # PRICE
    # ================================================================
    #
    # robust_z is the detector's statistical signal.
    # tightness_percentile provides additional evidence but should
    # never overwhelm the robust statistical deviation.
    #
    price = load_csv("bid_spread.csv")

    robust_z = pd.to_numeric(
        price["robust_z"],
        errors="coerce",
    ).fillna(0)

    tightness = pd.to_numeric(
        price["tightness_percentile"],
        errors="coerce",
    ).fillna(0)

    z_strength = robust_unit(
        robust_z,
        1.5,
        4.0,
    )

    tight_strength = robust_unit(
        tightness,
        0.90,
        1.00,
    )

    price_strength = (
        0.75 * z_strength
        + 0.25 * tight_strength
    ).clip(0, 1)

    bids = load_csv(
        "bids.csv"
    )[[
        "tender_id",
        "vendor_id",
    ]].drop_duplicates()

    price = price.merge(
        bids,
        on="tender_id",
        how="left",
    )

    for i, row in price.iterrows():
        strength = float(
            price_strength.iloc[i]
        )

        if strength < 0.10:
            continue

        vendor = row.get("vendor_id")

        if pd.isna(vendor):
            continue

        add_record(
            records,
            str(vendor),
            "price",
            strength,
            (
                f"tender {row['tender_id']} has unusually tight "
                f"bid separation; robust z={float(row['robust_z']):.2f}, "
                f"relative spread={float(row['relative_spread']):.4f}"
            ),
        )

    # ================================================================
    # TEMPORAL
    # ================================================================
    temporal = load_csv(
        "temporal_behavior.csv"
    )

    standardized = pd.to_numeric(
        temporal["standardized_win_shift"],
        errors="coerce",
    ).fillna(0).abs()

    behavioral = pd.to_numeric(
        temporal["behavioral_shift"],
        errors="coerce",
    ).fillna(0)

    standardized_strength = robust_unit(
        standardized,
        1.5,
        3.0,
    )

    behavioral_strength = robust_unit(
        behavioral,
        0.15,
        0.45,
    )

    temporal_strength = (
        0.70 * standardized_strength
        + 0.30 * behavioral_strength
    ).clip(0, 1)

    for i, row in temporal.iterrows():
        strength = float(
            temporal_strength.iloc[i]
        )

        if strength < 0.10:
            continue

        add_record(
            records,
            str(row["vendor_id"]),
            "temporal",
            strength,
            (
                f"win-rate changed from "
                f"{float(row['early_win_rate']):.2%} to "
                f"{float(row['late_win_rate']):.2%}; "
                f"standardized shift="
                f"{float(row['standardized_win_shift']):.2f}"
            ),
        )

    # ================================================================
    # GEOGRAPHIC
    # ================================================================
    geographic = load_csv(
        "geographic_behavior.csv"
    )

    participation = pd.to_numeric(
        geographic["dominant_region_share"],
        errors="coerce",
    ).fillna(0)

    win_share = pd.to_numeric(
        geographic["dominant_region_win_share"],
        errors="coerce",
    ).fillna(0)

    gap = (
        win_share - participation
    ).abs()

    geographic_strength = robust_unit(
        gap,
        0.20,
        0.60,
    )

    for i, row in geographic.iterrows():
        strength = float(
            geographic_strength.iloc[i]
        )

        if strength < 0.10:
            continue

        add_record(
            records,
            str(row["vendor_id"]),
            "geographic",
            strength,
            (
                f"dominant-region win share="
                f"{float(row['dominant_region_win_share']):.2%} "
                f"vs participation share="
                f"{float(row['dominant_region_share']):.2%}"
            ),
        )

    # ================================================================
    # WINNER ROTATION
    # ================================================================
    rotation = load_csv(
        "winner_rotation.csv"
    )

    transition_share = pd.to_numeric(
        rotation["pair_transition_share"],
        errors="coerce",
    ).fillna(0)

    rotation_strength = robust_unit(
        transition_share,
        0.25,
        0.75,
    )

    for i, row in rotation.iterrows():
        strength = float(
            rotation_strength.iloc[i]
        )

        if strength < 0.10:
            continue

        for vendor in (
            row["vendor_a"],
            row["vendor_b"],
        ):
            add_record(
                records,
                str(vendor),
                "winner_rotation",
                strength,
                (
                    f"{int(row['pair_transitions'])} repeated "
                    f"winner transitions with {vendor}; "
                    f"transition share="
                    f"{float(row['pair_transition_share']):.2%}"
                ),
            )

    # ================================================================
    # WINNER CONCENTRATION
    # ================================================================
    concentration = load_csv(
        "winner_concentration.csv"
    )

    share = pd.to_numeric(
        concentration["top_vendor_share"],
        errors="coerce",
    ).fillna(0)

    concentration_strength = robust_unit(
        share,
        0.20,
        0.80,
    )

    for i, row in concentration.iterrows():
        strength = float(
            concentration_strength.iloc[i]
        )

        if strength < 0.10:
            continue

        add_record(
            records,
            str(row["top_vendor"]),
            "winner_concentration",
            strength,
            (
                f"top-vendor share="
                f"{float(row['top_vendor_share']):.2%} across "
                f"{int(row['tender_count'])} peer tenders"
            ),
        )

    evidence = pd.DataFrame(records)

    if evidence.empty:
        raise RuntimeError(
            "No evidence records were generated."
        )

    return evidence

def self_test(
    evidence: pd.DataFrame,
    cases: pd.DataFrame,
) -> None:
    required_families = set(FAMILY_WEIGHTS)

    actual_families = set(
        evidence["evidence_family"].unique()
    )

    missing = required_families - actual_families

    assert not missing, (
        f"Missing evidence families: {sorted(missing)}"
    )

    assert len(evidence) > 1000
    assert len(cases) >= 100

    assert cases["investigation_priority"].between(
        0,
        100,
    ).all()

    assert (
        cases["evidence_family_count"] >= 1
    ).all()

    # No single-family case may become a top-tier investigation.
    single_family_max = cases.loc[
        cases["evidence_family_count"] == 1,
        "investigation_priority",
    ].max()

    assert single_family_max <= 60, (
        f"Single-family case too strong: {single_family_max}"
    )

    # There must be actual convergence.
    assert (
        cases["evidence_family_count"] >= 2
    ).sum() >= 100

    print()
    print("[PASS] convergence self-test completed")


def scenario_validation(cases: pd.DataFrame) -> None:
    scenarios = {
        "REPEATED_NETWORK": ["V0001", "V0024", "V0091"],
        "LEGITIMATE_SPECIALIZATION": ["V0010", "V0020"],
        "COVER_BIDDING": ["V0042", "V0043"],
        "BID_ROTATION": ["V0051", "V0052", "V0053"],
        "GEOGRAPHIC_ALLOCATION": ["V0061", "V0062", "V0063"],
        "TIGHT_PRICE_CLUSTER": ["V0071", "V0072", "V0073", "V0074"],
    }

    print()
    print("=" * 72)
    print("PLANTED SCENARIO VALIDATION")
    print("=" * 72)

    for name, vendors in scenarios.items():
        subset = cases[
            cases["vendor_id"].isin(vendors)
        ]

        if subset.empty:
            raise AssertionError(
                f"No cases found for {name}"
            )

        top = subset.sort_values(
            "investigation_priority",
            ascending=False,
        ).iloc[0]

        print(
            f"{name:<25}"
            f" priority={int(top['investigation_priority']):>3}"
            f"  families={top['evidence_families']}"
        )

    legitimate = cases[
        cases["vendor_id"].isin(
            scenarios["LEGITIMATE_SPECIALIZATION"]
        )
    ]

    legitimate_max = int(
        legitimate["investigation_priority"].max()
    )

    print()
    print(
        "LEGITIMATE_SPECIALIZATION "
        f"max priority={legitimate_max}"
    )

    # The negative control must not appear in the top investigation tier.
    assert legitimate_max <= 70, (
        "Legitimate specialization remains too highly ranked: "
        f"{legitimate_max}"
    )

    # At least one planted non-legitimate scenario must outrank
    # the legitimate specialization controls.
    planted = cases[
        cases["vendor_id"].isin(
            [
                "V0001",
                "V0024",
                "V0091",
                "V0042",
                "V0043",
                "V0051",
                "V0052",
                "V0053",
                "V0061",
                "V0062",
                "V0063",
                "V0071",
                "V0072",
                "V0073",
                "V0074",
            ]
        )
    ]

    assert (
        planted["investigation_priority"].max()
        > legitimate_max
    )

    print()
    print("[PASS] planted scenario validation completed")


def main() -> None:
    print("=" * 72)
    print("VERITAS EVIDENCE CONVERGENCE ENGINE")
    print("=" * 72)

    evidence = build_evidence()
    cases = build_cases(evidence)

    evidence_path = DATA / "evidence_records.csv"
    cases_path = DATA / "investigation_cases.csv"

    evidence.to_csv(
        evidence_path,
        index=False,
    )

    cases.to_csv(
        cases_path,
        index=False,
    )

    print(
        f"Evidence records: {len(evidence):,}"
    )
    print(
        f"Investigation cases: {len(cases):,}"
    )

    print()
    print("Evidence families:")
    print(
        evidence["evidence_family"]
        .value_counts()
        .to_string()
    )

    print()
    print("Top investigation cases:")

    print(
        cases[
            [
                "case_id",
                "vendor_id",
                "investigation_priority",
                "evidence_family_count",
                "evidence_families",
                "weighted_evidence_strength",
                "convergence_strength",
                "context_factor",
            ]
        ]
        .head(20)
        .to_string(index=False)
    )

    print()
    print("Outputs:")
    print(
        f"[OK] {evidence_path.relative_to(BASE)}"
    )
    print(
        f"[OK] {cases_path.relative_to(BASE)}"
    )

    self_test(
        evidence,
        cases,
    )

    scenario_validation(
        cases
    )


if __name__ == "__main__":
    main()
